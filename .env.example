# Copy this file to .env, then set your personal OpenAI API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Each request can take longer when the research context is large.  The agent
# retries temporary timeout, connection, rate-limit, and server failures.
OPENAI_REQUEST_TIMEOUT_SECONDS=180
OPENAI_REQUEST_MAX_RETRIES=2
